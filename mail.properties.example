# Email settings for sign-up and login verification codes.
# Copy this file to mail.properties (in the same folder as run.ps1) and fill it in.
# mail.properties is ignored by git so your password is never committed.
# Without mail.properties, codes are printed in the server window instead of emailed.

# --- Gmail ---
# Gmail needs an "app password", not your normal password:
#   1. Turn on 2-Step Verification for your Google account.
#   2. Go to https://myaccount.google.com/apppasswords, create one, and paste the 16 letters below.
smtp.host=smtp.gmail.com
smtp.port=587
smtp.security=starttls
smtp.username=you@gmail.com
smtp.password=abcdefghijklmnop
mail.from=you@gmail.com

# --- Outlook.com / Hotmail ---
# smtp.host=smtp-mail.outlook.com
# smtp.port=587
# smtp.security=starttls

# smtp.security can be starttls (port 587), ssl (port 465) or none (local test servers only, no password).
